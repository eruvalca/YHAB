@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using YHAB.Data

@inject SignInManager<ApplicationUser> SignInManager

@if (_externalLogins.Length > 0)
{
    <section>
        <h3>@Heading</h3>
        <hr />
        <form action="Account/PerformExternalLogin" method="post">
            <div>
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                <div class="actions">
                    @foreach (var provider in _externalLogins)
                    {
                        <button type="submit" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                    }
                </div>
            </div>
        </form>
    </section>
}
