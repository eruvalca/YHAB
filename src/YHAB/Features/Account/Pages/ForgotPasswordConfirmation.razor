@page "/Account/ForgotPasswordConfirmation"

@using Microsoft.AspNetCore.Identity
@using YHAB.Data
@inject IEmailSender<ApplicationUser> EmailSender

<PageTitle>Forgot password confirmation</PageTitle>

<h1>Forgot password confirmation</h1>
<p role="alert">
    @if (EmailSender is IdentityNoOpEmailSender)
    {
        <span>No automated recovery email is sent.</span>
    }
    else
    {
        <span>If your account has a verified email address, please check your email to reset your password.</span>
    }
</p>
<p>Contact the person who runs this YHAB instance through your usual contact method if your email is unverified
    or you cannot receive a reset email. After verifying that the account belongs to you,
    they can give you a temporary password-reset link.</p>
