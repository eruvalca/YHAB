@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using YHAB.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AccountSignInService AccountSignIn
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Log in · YHAB</PageTitle>

<h1>Log in</h1>
<div class="account-sections">
    <section>
        <StatusMessage Message="@_errorMessage" />
        <EditForm class="account-form" EditContext="_editContext" method="post" OnSubmit="LoginUserAsync" FormName="login">
            <DataAnnotationsValidator />
            <h2>Use a local account to log in.</h2>
            <hr />
            <ValidationSummary class="error-text" role="alert" />
            <div class="form-field">
                <label for="Input.Email">Email</label>
                <InputText @bind-Value="Input.Email" id="Input.Email" autocomplete="username webauthn" aria-required="true" placeholder="name@example.com" />
                <ValidationMessage For="() => Input.Email" class="error-text" />
            </div>
            <div class="form-field">
                <label for="Input.Password">Password</label>
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" autocomplete="current-password" aria-required="true" placeholder="password" />
                <ValidationMessage For="() => Input.Password" class="error-text" />
            </div>
            <div>
                <label class="checkbox-field">
                    <InputCheckbox @bind-Value="Input.RememberMe" />
                    Remember me
                </label>
            </div>
            <div>
                <button type="submit">Log in</button>
            </div>
            <PasskeySubmit Operation="PasskeyOperation.Request" Name="Input.Passkey" EmailName="Input.Email" class="passkey-login-link">Log in with a passkey</PasskeySubmit>
            <hr />
            <div>
                <p>
                    <a href="Account/ForgotPassword">Forgot your password?</a>
                </p>
                <p>
                    <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?>(StringComparer.Ordinal) { ["ReturnUrl"] = ReturnUrl }))">Register as a new user</a>
                </p>
                @if (UserManager.Options.SignIn.RequireConfirmedAccount)
                {
                    <p>
                        <a href="Account/ResendEmailConfirmation">Resend email confirmation</a>
                    </p>
                }
            </div>
        </EditForm>
    </section>
    <ExternalLoginPicker Heading="Use another service to log in." />
</div>
