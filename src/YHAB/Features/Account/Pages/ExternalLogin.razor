@page "/Account/ExternalLogin"

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using YHAB.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject AccountSignInService AccountSignIn
@inject UserManager<ApplicationUser> UserManager
@inject AccountRegistrationService AccountRegistration
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ExternalLogin> Logger

<PageTitle>Register</PageTitle>

<StatusMessage Message="@_message" />
@if (_linkFailure is not null)
{
    <h1>Finish setting up your account</h1>
    <ol>
        <li><a href="Account/ResendEmailConfirmation">Request a confirmation email</a> and confirm your email address.</li>
        <li><a href="Account/ForgotPassword">Reset your password</a>, then sign in with your email and password.</li>
        <li>Open <a href="Account/Manage/ExternalLogins">External logins</a> to manage the external account link.</li>
    </ol>
    @if (EmailSender is IdentityNoOpEmailSender)
    {
        <p>This app has no email sender configured. Use the existing
            <a href="@(NavigationManager.GetUriWithQueryParameters("Account/RegisterConfirmation", new Dictionary<string, object?>(StringComparer.Ordinal) { ["email"] = Input.Email }))">development confirmation page</a>
            to confirm your email. Password reset requires an email sender.</p>
    }
}
else
{
    <h1>Register</h1>
    <h2>Associate your @ProviderDisplayName account.</h2>
    <hr />

    <div  class="notice" data-kind="information">
        You've successfully authenticated with <strong>@ProviderDisplayName</strong>.
        Please enter an email address for this site below and click the Register button to finish
        logging in.
    </div>

    <EditForm class="account-form" Model="Input" OnValidSubmit="OnValidSubmitAsync" FormName="confirmation" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="error-text" role="alert" />
        <div class="form-field">
            <label for="Input.Email">Email</label>
            <InputText @bind-Value="Input.Email" id="Input.Email" autocomplete="email" placeholder="Please enter your email." />
            <ValidationMessage For="() => Input.Email" />
        </div>
        <button type="submit">Register</button>
    </EditForm>
}
