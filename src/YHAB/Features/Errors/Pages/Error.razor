@page "/Error"

<PageTitle>Something went wrong · YHAB</PageTitle>

<div class="page-intro">
    <p class="eyebrow">A SMALL DETOUR</p>
    <h1>Something went wrong.</h1>
    <p class="lead">We couldn't finish that request. Please try again, or head back to somewhere familiar.</p>
</div>

<div class="actions">
    <a class="primary-action" href="@RetryUrl">Try again</a>
    <a class="secondary-action" href="/">Return home</a>
    <a class="secondary-action" href="/plans">Open your plans</a>
</div>

@if (ShowRequestId)
{
    <p class="field-hint">If you contact support, mention request <code>@RequestId</code>.</p>
}
