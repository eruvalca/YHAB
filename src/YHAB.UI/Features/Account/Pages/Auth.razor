@page "/auth"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Auth</PageTitle>

<h1>You are authenticated</h1>

<AuthorizeView>
    <div class="account-summary">
        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalM)">
                <p>Hello @context.User.Identity?.Name!</p>
                <a href="Account/Manage">Manage your account</a>
            </FluentStack>
        </FluentCard>
    </div>
</AuthorizeView>
