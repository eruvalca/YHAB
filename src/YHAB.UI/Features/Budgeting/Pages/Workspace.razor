@inherits YHAB.UI.Components.CancellableComponentBase
@page "/plans/{PlanId:guid}"
@page "/plans/{PlanId:guid}/accounts"
@page "/plans/{PlanId:guid}/accounts/{AccountId:guid}"
@attribute [Authorize]
@rendermode InteractiveAuto

<PageTitle>@(Snapshot?.Name ?? "Your plan") · YHAB</PageTitle>
<FluentProviders />
@if (_hasUpdates)
{
    <div class="notice" data-kind="information" role="status">New transactions or changes are available. Finish your entry, then refresh the plan.</div>
}
@if (_error is not null)
{
    <div class="notice" data-kind="error" role="alert">@_error <FluentButton OnClick="RefreshAsync" Disabled="_busy" Size="ButtonSize.Small" Appearance="ButtonAppearance.Subtle">Refresh plan</FluentButton>
        @if (_operation.CanRetry) { <FluentButton OnClick="RetryAsync" Appearance="ButtonAppearance.Subtle">Retry save safely</FluentButton> }
    </div>
}
@if (Snapshot is { } plan)
{
    <div class="workspace" aria-busy="@(_busy ? "true" : "false")" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")" data-renderer="@RendererInfo.Name">
        <PlanFrame Plan="plan" Balances="_view?.Balances" OnAddAccount="AddAccount" Busy="IsBusy">

            <div class="workspace-toolbar">
                <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalS)" VerticalGap="var(--spacingVerticalS)" Class="workspace-tools">
                    <FluentButton OnClick="UndoAsync" Disabled="@(IsBusy || !plan.CanUndo)" Size="ButtonSize.Small" Appearance="ButtonAppearance.Subtle" title="Undo (Ctrl+Z)">Undo</FluentButton>
                    <FluentButton OnClick="RedoAsync" Disabled="@(IsBusy || !plan.CanRedo)" Size="ButtonSize.Small" Appearance="ButtonAppearance.Subtle" title="Redo (Ctrl+Shift+Z)">Redo</FluentButton>
                    <FluentButton OnClick="RefreshAsync" Disabled="_busy" Size="ButtonSize.Small" Appearance="ButtonAppearance.Subtle">Refresh</FluentButton>
                    <span class="workspace-status muted" role="status">@_operation.Message</span>
                </FluentStack>
            </div>
            @if (_accountEditor)
            {
                <AccountEditor @key="_editingAccount?.Id" Plan="plan" Account="_editingAccount" OnCommand="ExecuteAsync" OnClose="CloseAccount" Busy="IsBusy" />
            }
            @if (IsRegister)
            {
                <AccountRegister @key="plan.Id" Plan="plan" Balances="_view?.Balances" LoadPage="LoadRegisterAsync" LoadPayees="LoadPayeesAsync" AccountId="AccountId" OnCommand="ExecuteAsync" OnEditAccount="EditAccount" Busy="IsBusy" />
            }
            else
            {
                <BudgetBoard @key="plan.Id" Plan="plan" LoadMonth="LoadMonthAsync" OnCommand="ExecuteAsync" Busy="IsBusy" />
            }
            <details class="history-panel">
                <summary>Recent changes & keyboard shortcuts</summary>
                <p class="muted">Ctrl+Z undo · Ctrl+Shift+Z redo. Shortcuts leave text fields alone. Your latest 50 changes can be undone.</p>
                <ol>@foreach (var change in plan.Changes) { <li>@change.Description <small class="muted">@change.Timestamp.ToLocalTime().ToString("g", Culture)</small></li> }</ol>
            </details>
        </PlanFrame>
    </div>
}
else if (_error is null)
{
    <p role="status">Opening your plan…</p>
}
