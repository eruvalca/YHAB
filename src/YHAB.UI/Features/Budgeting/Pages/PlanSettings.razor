@inherits YHAB.UI.Components.CancellableComponentBase
@page "/plans/{PlanId:guid}/settings"
@attribute [Authorize]
<PageTitle>Plan settings · YHAB</PageTitle>
@if (_pageError is not null) { <div class="notice" data-kind="error" role="alert">@_pageError</div> }
@if (_plan is { } plan)
{
    <PlanFrame Plan="plan" Balances="_balances">
        <p class="eyebrow">MAKE IT YOURS</p><h1>Plan settings</h1>
        <section class="surface" id="plan-settings-section">
            <h2>A plan with a purpose</h2>
            <EditForm Model="Settings" method="post" FormName="PlanSettings" OnValidSubmit="SaveAsync" OnInvalidSubmit="SaveInvalid" Enhance>
                <DataAnnotationsValidator />
                <input type="hidden" name="Settings.Version" value="@Settings.Version" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalL)">
                    <div class="form-field"><label for="settings-name">Plan name</label><InputText id="settings-name" @bind-Value="Settings.Name" maxlength="100" aria-describedby="settings-name-error" data-validation-focus /><ValidationMessage For="() => Settings.Name" id="settings-name-error" role="alert" /></div>
                    <div class="form-field"><label for="settings-notes">Notes & intentions</label><InputTextArea id="settings-notes" @bind-Value="Settings.Notes" maxlength="4000" rows="4" aria-describedby="settings-notes-error" data-validation-focus /><ValidationMessage For="() => Settings.Notes" id="settings-notes-error" role="alert" /></div>
                    <button type="submit" class="primary-action">Save plan settings</button>
                    @if (_settingsFeedback is { } settingsFeedback) { <div class="notice" data-kind="@(settingsFeedback.IsError ? "error" : "success")" role="@(settingsFeedback.IsError ? "alert" : "status")">@settingsFeedback.Message</div> }
                </FluentStack>
            </EditForm>
        </section>
        <section class="surface report-section" id="rename-payee-section">
            <h2>Manage payees</h2><p>Rename a payee across posted and recurring transactions. You can undo this from your plan.</p>
            <EditForm Model="Payee" method="post" FormName="RenamePayee" OnValidSubmit="RenameAsync" OnInvalidSubmit="RenameInvalid" Enhance>
                <DataAnnotationsValidator />
                <input type="hidden" name="Payee.Version" value="@Payee.Version" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalL)">
                    <div class="form-field"><label for="old-payee">Existing payee</label><InputSelect id="old-payee" @bind-Value="Payee.OldName" aria-describedby="old-payee-error" data-validation-focus><option value="">Choose a payee</option>@foreach (var name in _payees) { <option value="@name">@name</option> }</InputSelect><ValidationMessage For="() => Payee.OldName" id="old-payee-error" role="alert" /></div>
                    <div class="form-field"><label for="new-payee">New name</label><InputText id="new-payee" @bind-Value="Payee.NewName" maxlength="200" aria-describedby="new-payee-error" data-validation-focus /><ValidationMessage For="() => Payee.NewName" id="new-payee-error" role="alert" /></div>
                    <button type="submit" class="primary-action">Rename payee</button>
                    @if (_renameFeedback is { } renameFeedback) { <div class="notice" data-kind="@(renameFeedback.IsError ? "error" : "success")" role="@(renameFeedback.IsError ? "alert" : "status")">@renameFeedback.Message</div> }
                </FluentStack>
            </EditForm>
        </section>
        <section class="surface" id="sharing-section">
            <h2>Share this plan</h2>
            @if (_sharing is { } sharing)
            {
                @if (sharing.IsOwner)
                {
                    <p>Create a one-time code and give it to the person you want to add. Codes expire after seven days and stop working once used. Everyone with access can open and edit this plan and will see your display name (@sharing.OwnerName), but never your email address.</p>
                    <EditForm Model="ShareCodeForm" id="create-share-code-form" method="post" FormName="CreateShareCode" OnValidSubmit="CreateShareCodeAsync" Enhance>
                        <input type="hidden" name="ShareCodeForm.Action" value="@ShareCodeForm.Action" />
                        <button type="submit" class="primary-action">Create share code</button>
                        @if (_shareFeedback is { } shareFeedback) { <div class="notice" data-kind="@(shareFeedback.IsError ? "error" : "success")" role="@(shareFeedback.IsError ? "alert" : "status")">@shareFeedback.Message</div> }
                    </EditForm>
                    @if (_shareCode is { } shareCode)
                    {
                        <div class="notice" data-kind="success" role="status" data-share-code>
                            <p>Give this code to the person you want to add. It can be used once and expires on @shareCode.ExpiresOn.LocalDateTime.ToString("D").</p>
                            <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalM)" VerticalGap="var(--spacingVerticalS)" Wrap="true">
                                <code class="share-code">@shareCode.Code</code>
                                <button type="button" class="secondary-action" data-copy-share-code>Copy code</button>
                            </FluentStack>
                            <p class="field-hint" role="status" aria-live="polite" data-copy-share-code-status></p>
                        </div>
                    }
                }
                else
                {
                    <p>This plan is shared with you by @sharing.OwnerName. Everyone with access can open and edit it.</p>
                }
                @if (sharing.Collaborators.Count == 0)
                {
                    <p class="muted">No one else has access yet.</p>
                }
                else
                {
                    <h3>People with access</h3>
                    <ul class="share-list">
                        @foreach (var person in LabeledCollaborators())
                        {
                            <li @key="person.UserId">@person.Label</li>
                        }
                    </ul>
                }
                @if (sharing.IsOwner && sharing.Collaborators.Count > 0)
                {
                    <EditForm EditContext="_removeEditContext" id="remove-share-form" method="post" FormName="RemoveShare" OnValidSubmit="RemoveAsync" Enhance>
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalM)">
                            <div class="form-field">
                                <label for="remove-person">Stop sharing with</label>
                                <InputSelect id="remove-person" @bind-Value="Remove.MemberId" aria-describedby="@(_removeFeedback is { IsError: true } ? "remove-person-error" : null)" data-validation-focus><option value="">Choose a person</option>@foreach (var person in LabeledCollaborators()) { <option value="@person.UserId">@person.Label</option> }</InputSelect>
                                @if (_removeFeedback is { IsError: true } removeError) { <p id="remove-person-error" class="validation-message" role="alert">@removeError.Message</p> }
                            </div>
                            <button type="submit" class="secondary-action">Remove access</button>
                        </FluentStack>
                    </EditForm>
                    <h3>Transfer ownership</h3>
                    <p>Make a collaborator the owner. You stay on the plan with edit access, and only the new owner can change access or delete the plan.</p>
                    <EditForm EditContext="_transferEditContext" id="transfer-owner-form" method="post" FormName="TransferOwnership" OnValidSubmit="TransferAsync" Enhance>
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalM)">
                            <div class="form-field">
                                <label for="transfer-person">New owner</label>
                                <InputSelect id="transfer-person" @bind-Value="Transfer.MemberId" aria-describedby="@(_transferFeedback is { IsError: true } ? "transfer-person-error" : null)" data-validation-focus><option value="">Choose a person</option>@foreach (var person in LabeledCollaborators()) { <option value="@person.UserId">@person.Label</option> }</InputSelect>
                                @if (_transferFeedback is { IsError: true } transferError) { <p id="transfer-person-error" class="validation-message" role="alert">@transferError.Message</p> }
                            </div>
                            <button type="submit" class="secondary-action">Transfer ownership</button>
                        </FluentStack>
                    </EditForm>
                }
                @if (sharing.IsOwner && _removeFeedback is { IsError: false } removeSuccess) { <div class="notice" data-kind="success" role="status">@removeSuccess.Message</div> }
                @if (_transferFeedback is { IsError: false } transferSuccess) { <div class="notice" data-kind="success" role="status">@transferSuccess.Message</div> }
                @if (!sharing.IsOwner)
                {
                    <EditForm Model="Leave" id="leave-plan-form" method="post" FormName="LeavePlan" OnValidSubmit="LeaveAsync" OnInvalidSubmit="LeaveInvalid" Enhance>
                        <DataAnnotationsValidator />
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalM)">
                            <div class="checkbox-field"><label for="leave-confirm">I understand I will lose access to this plan.</label><InputCheckbox id="leave-confirm" @bind-Value="Leave.Confirmed" aria-describedby="leave-confirm-error" data-validation-focus /><ValidationMessage For="() => Leave.Confirmed" id="leave-confirm-error" role="alert" /></div>
                            <button type="submit" class="secondary-action">Leave this plan</button>
                            @if (_leaveFeedback is { } leaveFeedback) { <div class="notice" data-kind="@(leaveFeedback.IsError ? "error" : "success")" role="@(leaveFeedback.IsError ? "alert" : "status")">@leaveFeedback.Message</div> }
                        </FluentStack>
                    </EditForm>
                }
            }
        </section>
        @if (_sharing is { IsOwner: true })
        {
            <details class="danger-zone" id="delete-plan-section" open="@(_deleteFeedback is { IsError: true })">
                <summary>Delete this plan</summary>
                <p>Deleting <strong>@plan.Name</strong> permanently removes its accounts, categories, transactions, balances, share codes, and history. It cannot be undone, and everyone else loses access immediately.</p>
                <p><a href="@($"/api/plans/{PlanId}")" download="@($"plan-{PlanId}.json")">Download this plan's data</a> before deleting it.</p>
                <EditForm EditContext="_deleteEditContext" id="delete-plan-form" method="post" FormName="DeletePlan" OnValidSubmit="DeleteAsync" Enhance>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalM)">
                        <div class="form-field">
                            <label for="delete-plan-name">Type <strong>@plan.Name</strong> to confirm</label>
                            <InputText id="delete-plan-name" @bind-Value="Delete.PlanName" maxlength="100" autocomplete="off" aria-describedby="@(_deleteFeedback is { IsError: true } ? "delete-plan-name-error" : null)" data-validation-focus />
                            @if (_deleteFeedback is { IsError: true } deleteError) { <p id="delete-plan-name-error" class="validation-message" role="alert">@deleteError.Message</p> }
                        </div>
                        <button type="submit" class="secondary-action">Delete plan permanently</button>
                    </FluentStack>
                </EditForm>
            </details>
        }
        <p class="muted">USD · US dates · manual accounts</p>
    </PlanFrame>
}
