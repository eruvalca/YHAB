@inherits YHAB.UI.Components.CancellableComponentBase
@page "/plans/{PlanId:guid}/settings"
@attribute [Authorize]
<PageTitle>Plan settings · YHAB</PageTitle>
@if (_message is not null) { <div class="notice" data-kind="@(_failed ? "error" : "success")" role="status">@_message</div> }
@if (_plan is { } plan)
{
    <PlanFrame Plan="plan" Balances="_balances">
        <p class="eyebrow">MAKE IT YOURS</p><h1>Plan settings</h1>
        <section class="surface">
            <h2>A plan with a purpose</h2>
            <EditForm Model="Settings" method="post" FormName="PlanSettings" OnValidSubmit="SaveAsync" Enhance>
                <DataAnnotationsValidator /><ValidationSummary />
                <input type="hidden" name="Settings.Version" value="@Settings.Version" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalL)">
                    <div class="form-field"><label for="settings-name">Plan name</label><InputText id="settings-name" @bind-Value="Settings.Name" maxlength="100" /></div>
                    <div class="form-field"><label for="settings-notes">Notes & intentions</label><InputTextArea id="settings-notes" @bind-Value="Settings.Notes" maxlength="4000" rows="4" /></div>
                    <button type="submit" class="primary-action">Save plan settings</button>
                </FluentStack>
            </EditForm>
        </section>
        <section class="surface report-section">
            <h2>Manage payees</h2><p>Rename a payee across posted and recurring transactions. You can undo this from your plan.</p>
            <EditForm Model="Payee" method="post" FormName="RenamePayee" OnValidSubmit="RenameAsync" Enhance>
                <DataAnnotationsValidator /><ValidationSummary />
                <input type="hidden" name="Payee.Version" value="@Payee.Version" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalL)">
                    <div class="form-field"><label for="old-payee">Existing payee</label><InputSelect id="old-payee" @bind-Value="Payee.OldName"><option value="">Choose a payee</option>@foreach (var name in _payees) { <option value="@name">@name</option> }</InputSelect></div>
                    <div class="form-field"><label for="new-payee">New name</label><InputText id="new-payee" @bind-Value="Payee.NewName" maxlength="200" /></div>
                    <button type="submit" class="primary-action">Rename payee</button>
                </FluentStack>
            </EditForm>
        </section>
        <section class="surface">
            <h2>Share this plan</h2>
            @if (_sharing is { } sharing)
            {
                @if (sharing.IsOwner)
                {
                    <p>Create a one-time code and give it to the person you want to add. Codes expire after seven days and stop working once used. Everyone with access can open and edit this plan.</p>
                    <EditForm Model="ShareCodeForm" id="create-share-code-form" method="post" FormName="CreateShareCode" OnValidSubmit="CreateShareCodeAsync" Enhance>
                        <input type="hidden" name="ShareCodeForm.Action" value="@ShareCodeForm.Action" />
                        <button type="submit" class="primary-action">Create share code</button>
                    </EditForm>
                    @if (_shareCode is { } shareCode)
                    {
                        <div class="notice" data-kind="success" role="status">
                            <p>Give this code to the person you want to add. It can be used once and expires on @shareCode.ExpiresOn.LocalDateTime.ToString("D").</p>
                            <p class="share-code">@shareCode.Code</p>
                        </div>
                    }
                }
                else
                {
                    <p>This plan is shared with you by @sharing.OwnerName. Everyone with access can open and edit it.</p>
                }
                @if (sharing.Collaborators.Count == 0)
                {
                    <p class="muted">No one else has access yet.</p>
                }
                else
                {
                    <h3>People with access</h3>
                    <ul class="share-list">
                        @foreach (var person in sharing.Collaborators)
                        {
                            <li @key="person.UserId">@person.Name</li>
                        }
                    </ul>
                }
                @if (sharing.IsOwner && sharing.Collaborators.Count > 0)
                {
                    <EditForm Model="Remove" id="remove-share-form" method="post" FormName="RemoveShare" OnValidSubmit="RemoveAsync" Enhance>
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalM)">
                            <div class="form-field">
                                <label for="remove-person">Stop sharing with</label>
                                <InputSelect id="remove-person" @bind-Value="Remove.MemberId"><option value="">Choose a person</option>@foreach (var person in sharing.Collaborators) { <option value="@person.UserId">@person.Name</option> }</InputSelect>
                            </div>
                            <button type="submit" class="secondary-action">Remove access</button>
                        </FluentStack>
                    </EditForm>
                }
                @if (!sharing.IsOwner)
                {
                    <EditForm Model="Leave" id="leave-plan-form" method="post" FormName="LeavePlan" OnValidSubmit="LeaveAsync" Enhance>
                        <DataAnnotationsValidator /><ValidationSummary />
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalM)">
                            <div class="checkbox-field"><label for="leave-confirm">I understand I will lose access to this plan.</label><InputCheckbox id="leave-confirm" @bind-Value="Leave.Confirmed" /></div>
                            <button type="submit" class="secondary-action">Leave this plan</button>
                        </FluentStack>
                    </EditForm>
                }
            }
        </section>
        <p class="muted">USD · US dates · manual accounts</p>
    </PlanFrame>
}
