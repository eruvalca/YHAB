@inherits YHAB.UI.Components.CancellableComponentBase
@page "/plans"
@attribute [Authorize]
<PageTitle>Your plans · YHAB</PageTitle>
<div class="page-intro">
    <p class="eyebrow">A FRESH PERSPECTIVE</p>
    <h1>Make room for what matters.</h1>
    <p class="lead">Give every dollar a purpose. Build a little more breathing room.</p>
</div>
@if (_error is not null)
{
    <p class="notice" data-kind="error" role="alert">@_error</p>
}
<FluentGrid Spacing="6">
    <FluentGridItem Xs="12" Lg="8">
        @if (_ownedPlans.Count == 0 && _sharedPlans.Count == 0)
        {
            <h2>Your plans</h2>
            <div class="empty-state"><h3>A clearer picture starts here.</h3><p>Create your first plan, add the money you have, and decide what it needs to do.</p></div>
        }
        @if (_ownedPlans.Count > 0)
        {
            <h2>Your plans</h2>
            <FluentGrid Spacing="4">
                @foreach (var plan in _ownedPlans)
                {
                    <FluentGridItem @key="plan.Id" Xs="12" Md="6">
                        <a class="plan-card" href="@($"/plans/{plan.Id}")">
                            <FluentIcon Value="@(new Icons.Regular.Size32.Wallet())" aria-hidden="true" />
                            <h3>@plan.Name</h3>
                            <p>@(string.IsNullOrWhiteSpace(plan.Notes) ? "A plan for the life you want." : plan.Notes)</p>
                            <span class="plan-card-action">Open plan <span aria-hidden="true">↗</span></span>
                        </a>
                    </FluentGridItem>
                }
            </FluentGrid>
        }
        @if (_sharedPlans.Count > 0)
        {
            <h2>Shared with you</h2>
            <p class="muted">Everyone with access can open and edit these plans.</p>
            <FluentGrid Spacing="4">
                @foreach (var plan in _sharedPlans)
                {
                    <FluentGridItem @key="plan.Id" Xs="12" Md="6">
                        <a class="plan-card" href="@($"/plans/{plan.Id}")">
                            <FluentIcon Value="@(new Icons.Regular.Size32.Wallet())" aria-hidden="true" />
                            <h3>@plan.Name</h3>
                            <p class="plan-card-shared">Shared by @plan.SharedBy</p>
                            <p>@(string.IsNullOrWhiteSpace(plan.Notes) ? "A plan for the life you want." : plan.Notes)</p>
                            <span class="plan-card-action">Open plan <span aria-hidden="true">↗</span></span>
                        </a>
                    </FluentGridItem>
                }
            </FluentGrid>
        }
    </FluentGridItem>
    <FluentGridItem Xs="12" Lg="4">
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch" VerticalGap="var(--spacingVerticalXXL)" Width="100%">
            <section class="surface">
                <p class="eyebrow">START SOMETHING GOOD</p>
                <h2>Create a plan</h2>
                <EditForm Model="Input" id="create-plan-form" method="post" FormName="CreatePlan" OnValidSubmit="CreateAsync" Enhance>
                    <DataAnnotationsValidator />
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalL)">
                        <div class="form-field">
                            <label for="plan-name">Plan name</label>
                            <InputText id="plan-name" @bind-Value="Input.Name" placeholder="My everyday plan" maxlength="100" aria-describedby="plan-name-error" data-validation-focus />
                            <ValidationMessage For="() => Input.Name" id="plan-name-error" role="alert" />
                        </div>
                        <div class="checkbox-field"><label for="starter-categories">Start with suggested categories</label><InputCheckbox id="starter-categories" @bind-Value="Input.StarterCategories" /></div>
                        <button class="primary-action" type="submit">Create your plan →</button>
                        @if (_createError is not null)
                        {
                            <p class="notice" data-kind="error" role="alert">@_createError</p>
                        }
                        <p class="field-hint">Plans start private. Create a share code whenever you want to add someone.</p>
                    </FluentStack>
                </EditForm>
            </section>
            <section class="surface">
                <p class="eyebrow">ALREADY INVITED?</p>
                <h2>Join a shared plan</h2>
                <p class="muted">Enter the one-time code the plan owner gave you.</p>
                <EditForm EditContext="_joinEditContext" id="join-plan-form" method="post" FormName="JoinPlan" OnValidSubmit="JoinAsync" OnInvalidSubmit="JoinInvalid" Enhance>
                    <DataAnnotationsValidator />
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalL)">
                        <div class="form-field">
                            <label for="join-code">Share code</label>
                            <InputText id="join-code" @bind-Value="Join.Code" placeholder="ABCDE-ABCDE-ABCDE-ABCDE" maxlength="64" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-describedby="join-code-hint join-code-error" data-validation-focus />
                            <p class="field-hint" id="join-code-hint">Paste the code you were given. Dashes, spaces, and capitals do not matter.</p>
                            <ValidationMessage For="() => Join.Code" id="join-code-error" role="alert" />
                        </div>
                        <button type="submit" class="primary-action">Join plan</button>
                    </FluentStack>
                </EditForm>
            </section>
        </FluentStack>
    </FluentGridItem>
</FluentGrid>
