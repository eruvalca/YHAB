@inherits YHAB.UI.Components.CancellableComponentBase
@page "/plans/{PlanId:guid}/reports"
@attribute [Authorize]
<PageTitle>Reflect · YHAB</PageTitle>
@if (_error is not null) { <div class="notice" data-kind="error" role="alert">@_error</div> }
@if (_plan is { } plan)
{
    <PlanFrame Plan="plan" Balances="_balances">
        <div class="report-heading"><div><p class="eyebrow">A STEP BACK. A CLEARER PICTURE.</p><h1>Reflect</h1><p class="lead">See where your money went, and how far you've come.</p></div><button class="secondary-action print-button" type="button" onclick="window.print()">Print report</button></div>
        <nav class="report-presets" aria-label="Report presets"><a href="@PresetUrl("this-month")">This month</a><a href="@PresetUrl("last-month")">Last month</a><a href="@PresetUrl("year-to-date")">Year to date</a></nav>
        <form method="get" class="report-filter">
            <FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalM)">
                <div class="form-field"><label for="report-from">From</label><input id="report-from" name="from" type="date" value="@_fromText" aria-describedby="report-range-error" required /></div>
                <div class="form-field"><label for="report-to">Through</label><input id="report-to" name="to" type="date" value="@_throughText" aria-describedby="report-range-error" required /></div>
                <button class="primary-action" type="submit">Update reports</button>
            </FluentStack>
            @if (_rangeError is not null) { <p class="field-error" id="report-range-error" role="alert">@_rangeError</p> }
        </form>
        @if (_rangeError is null && _error is null && !HasActivity)
        {
            <section class="surface report-section report-empty"><h2>No activity in this range</h2><p>Try a wider range, or add transactions and return to this report.</p><a class="primary-action" href="@RangeUrl(plan.Today.AddYears(-1), plan.Today)">Show the last year</a></section>
        }
        else if (_rangeError is null && _error is null)
        {
            <div class="report-actions"><a class="secondary-action" href="@CsvHref" download="@CsvFileName">Download CSV</a></div>
            <FluentGrid Spacing="3" Class="summary-grid">
                <FluentGridItem Xs="6" Md="3"><div class="stat"><span>Income</span><strong data-money-tone="@MoneyTone(Income)">@Money(Income)</strong><small>@Comparison(Income, PreviousIncome)</small></div></FluentGridItem>
                <FluentGridItem Xs="6" Md="3"><div class="stat"><span>Spending</span><strong data-money-tone="@MoneyTone(-Spending)">@Money(Spending)</strong><small>@Comparison(Spending, PreviousSpending)</small></div></FluentGridItem>
                <FluentGridItem Xs="6" Md="3"><div class="stat"><span>Net income</span><strong data-money-tone="@MoneyTone(Income - Spending)">@Money(Income - Spending)</strong><small>@Comparison(Income - Spending, PreviousIncome - PreviousSpending)</small></div></FluentGridItem>
                <FluentGridItem Xs="6" Md="3"><div class="stat"><span>Net worth</span><strong data-money-tone="@MoneyTone(NetWorth)">@Money(NetWorth)</strong><small>@Comparison(NetWorth, PreviousNetWorth)</small></div></FluentGridItem>
            </FluentGrid>
            <section class="surface report-section"><h2>Net worth trend</h2><div class="trend-chart">
                <svg viewBox="0 0 640 180" role="img" aria-labelledby="net-worth-chart-title"><title id="net-worth-chart-title">Net worth trend from @_months[0].Month.ToString("MMMM yyyy", Culture) to @_months[^1].Month.ToString("MMMM yyyy", Culture)</title><polyline points="@NetWorthPoints" fill="none" vector-effect="non-scaling-stroke" />
                    @foreach (var point in GetChartPoints()) { <circle cx="@point.X" cy="@point.Y" r="4"><title>@point.Month.ToString("MMMM yyyy", Culture): @Money(point.Value)</title></circle> }
                </svg><div class="trend-labels"><span>@_months[0].Month.ToString("MMM yyyy", Culture)</span><span>@_months[^1].Month.ToString("MMM yyyy", Culture)</span></div>
            </div></section>
            <section class="surface report-section"><h2>Income vs spending</h2><div class="cash-flow-list">
                @foreach (var month in _months)
                {
                    <div class="cash-flow-row"><span>@month.Month.ToString("MMM yyyy", Culture)</span><div class="cash-flow-bars"><span class="income-bar" style="width:@CashFlowWidth(month.Income)" title="Income @Money(month.Income)"></span><span class="expense-bar" style="width:@CashFlowWidth(month.Expense)" title="Spending @Money(month.Expense)"></span></div><span class="numeric">@Money(month.NetIncome)</span></div>
                }
            </div></section>
            <section class="surface report-section">
                <h2>Spending by category</h2><p class="muted">Purchases less refunds. Select a category to see its transactions in this date range.</p>
                @foreach (var row in _spending)
                {
                    <div class="spending-row"><FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalL)"><strong class="money">@Money(row.Amount)</strong><a href="@RegisterUrl(row.CategoryId)">@row.Name</a><span class="muted">@Share(row.Amount) of spending</span><span>Budgeted @Money(Budgeted(row.CategoryId))</span></FluentStack><meter min="0" max="@MaxSpending" value="@Math.Max(0, row.Amount)" aria-label="@($"{row.Name}: {Money(row.Amount)}")"></meter></div>
                }
            </section>
            <section class="surface report-section">
                <h2>Income & expense</h2>
                <div class="table-container"><table><thead><tr><th scope="col">Month</th><th scope="col" class="numeric">Income</th><th scope="col" class="numeric">Expense</th><th scope="col" class="numeric">Net income</th></tr></thead><tbody>
                    @foreach (var month in _months) { <tr><th scope="row">@month.Month.ToString("MMM yyyy", Culture)</th><td class="numeric">@Money(month.Income)</td><td class="numeric">@Money(month.Expense)</td><td class="numeric">@Money(month.NetIncome)</td></tr> }
                </tbody></table></div>
            </section>
            <section class="surface report-section">
                <h2>Net worth details</h2><p class="muted">Assets minus debt across budget, loan, and tracking accounts, at the end of each period.</p>
                <div class="table-container"><table><thead><tr><th scope="col">Month</th><th scope="col" class="numeric">Assets</th><th scope="col" class="numeric">Debt</th><th scope="col" class="numeric">Net worth</th></tr></thead><tbody>
                    @foreach (var month in _months) { <tr><th scope="row">@month.Month.ToString("MMM yyyy", Culture)</th><td class="numeric">@Money(month.Assets)</td><td class="numeric">@Money(month.Debt)</td><td class="numeric"><strong data-money-tone="@MoneyTone(month.NetWorth)">@Money(month.NetWorth)</strong></td></tr> }
                </tbody></table></div>
            </section>
        }
    </PlanFrame>
}
