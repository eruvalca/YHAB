<div class="budget-grid category-row" role="row" data-category-id="@Row.Category.Id" data-selected="@(Selected ? "true" : "false")" @onclick="SelectAsync">
    <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalXS)" role="rowheader">
        @* Sortable only starts a drag from a handle with the sortable-grab class, so omitting it while busy disables dragging. *@
        <button type="button" class="@(Busy ? "row-move" : "row-move sortable-grab")" disabled="@Busy"
                aria-label="@($"Move {Row.Category.Name}")" title="Drag to reorder, or click for move controls"
                @onclick="ToggleMoveAsync" @onclick:stopPropagation="true"><FluentIcon Value="@(new Icons.Regular.Size16.ReOrderDotsVertical())" aria-hidden="true" /></button>
        <div class="category-name">
            <InlineNameEditor Label="Category name" Value="@Row.Category.Name" OnSave="RenameAsync" OnSelect="SelectAsync" Busy="Busy" Draft="Draft" />
            @if (Row.Category.Target is not null)
            {
                <small class="target-caption">@TargetCaption</small>
                <progress class="target-progress" max="100" value="@Progress" aria-label="@($"{Row.Category.Name} target progress")"></progress>
            }
        </div>
    </FluentStack>
    <div class="numeric" role="cell" @onclick:stopPropagation="true"><span class="visually-hidden">Assigned </span><AmountInput @key="(Row.Category.Id, Month)" Label="@($"Assign to {Row.Category.Name}")" Value="Row.Assigned" ValueChanged="AssignAsync" InputMode="TextInputMode.Decimal" Disabled="@(!RendererInfo.IsInteractive)" ReadOnly="Busy" /></div>
    <div class="numeric money" role="cell" data-money-tone="@MoneyTone(Row.Activity)"><span class="visually-hidden">Activity </span>@Money(Row.Activity)</div>
    <div class="numeric" role="cell"><span class="visually-hidden">Available </span><AvailablePill Plan="Plan" Budget="Budget" Row="Row" OnCommand="OnCommand" Tone="@Tone" Busy="Busy" />@if (Row.Available < 0) { <small>@(Row.CashOverspending > 0 ? "Cash overspent" : "Credit overspent")</small> }</div>
</div>
@if (Moving)
{
    <div class="category-move-row" role="row">
        <div role="cell" aria-colspan="4">
            <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="var(--spacingHorizontalS)">
                <FluentButton Size="ButtonSize.Small" OnClick="MoveUpAsync" Disabled="@(Busy || Index == 0)" Appearance="ButtonAppearance.Subtle">Move up</FluentButton>
                <FluentButton Size="ButtonSize.Small" OnClick="MoveDownAsync" Disabled="@(Busy || Index == Siblings.Length - 1)" Appearance="ButtonAppearance.Subtle">Move down</FluentButton>
                <FluentSelect TOption="GroupData" TValue="Guid" Label="Move to group" Items="Plan.Groups.OrderBy(item => item.SortOrder)" OptionText="item => item.Name" OptionValue="item => item.Id" Value="Row.Category.GroupId" ValueChanged="MoveToGroupAsync" Disabled="Busy" Margin="0" />
                <FluentButton Size="ButtonSize.Small" OnClick="ToggleMoveAsync" Appearance="ButtonAppearance.Subtle">Done</FluentButton>
            </FluentStack>
        </div>
    </div>
}
