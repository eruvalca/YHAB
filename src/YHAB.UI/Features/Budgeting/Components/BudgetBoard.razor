@inherits YHAB.UI.Components.CancellableComponentBase
@if (_error is not null) { <div class="notice" data-kind="error" role="alert">@_error</div> }
@if (_budget is not null)
{
<div class="budget-board">
    <section class="budget-summary" aria-label="Monthly budget summary" data-negative="@(_budget.ReadyToAssign < 0 ? "true" : "false")">
        <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.SpaceBetween" HorizontalGap="var(--spacingHorizontalM)" VerticalGap="var(--spacingVerticalS)">
            <div>
                <h1>Plan your money</h1>
                <FluentStack Width="auto" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalXS)" Class="month-navigation">
                    <FluentButton OnClick="PreviousAsync" Disabled="@(_month.Year <= 2000)" Size="ButtonSize.Small" IconOnly="true" Appearance="ButtonAppearance.Subtle" aria-label="Previous month">←</FluentButton>
                    <strong class="month-label">@_month.ToString("MMMM yyyy", Culture)</strong>
                    <FluentButton OnClick="NextAsync" Disabled="@(_month.Year >= 2100)" Size="ButtonSize.Small" IconOnly="true" Appearance="ButtonAppearance.Subtle" aria-label="Next month">→</FluentButton>
                    <FluentButton OnClick="CurrentAsync" Size="ButtonSize.Small" Appearance="ButtonAppearance.Subtle">Today</FluentButton>
                </FluentStack>
            </div>
            <div class="ready-balance" role="status" aria-atomic="true">
                <span>@(_budget.ReadyToAssign < 0 ? "Overassigned" : "Ready to assign")</span>
                <strong class="hero-amount" data-money-tone="@MoneyTone(_budget.ReadyToAssign)">@Money(_budget.ReadyToAssign)</strong>
            </div>
            <FluentStack Width="auto" Wrap="true" HorizontalGap="var(--spacingHorizontalS)" VerticalGap="var(--spacingVerticalXS)">
                <FluentButton OnClick="AutoAssignAsync" Disabled="@(IsBusy || _budget.ReadyToAssign <= 0)" Size="ButtonSize.Small" Appearance="ButtonAppearance.Primary">Fund targets</FluentButton>
                <FluentButton OnClick="ShowMove" Disabled="IsBusy" Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline">Move money</FluentButton>
            </FluentStack>
        </FluentStack>
        <FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalL)" VerticalGap="var(--spacingVerticalXS)" Class="budget-totals">
            <div class="budget-total"><span>Assigned</span> <strong>@Money(_budget.Assigned)</strong></div>
            <div class="budget-total"><span>Activity</span> <strong>@Money(_budget.Activity)</strong></div>
            <div class="budget-total"><span>Available</span> <strong>@Money(_budget.Available)</strong></div>
            <div class="budget-total"><span>Underfunded</span> <strong data-money-tone="@(_budget.Categories.Any(item => item.TargetNeeded > 0 || item.Available < 0) ? "attention" : "neutral")">@Money(_budget.Categories.Sum(item => Math.Max(item.TargetNeeded, -item.Available)))</strong></div>
        </FluentStack>
    </section>
    @if (_budget.CashOverspending + _budget.CreditOverspending > 0)
    {
        <div class="notice" data-kind="warning">@Money(_budget.CashOverspending) cash overspending and @Money(_budget.CreditOverspending) credit overspending. Move money into these categories to cover it.</div>
    }
    @if (_move)
    {
        <MoveMoneyEditor Plan="Plan" Month="_month" OnCommand="OnCommand" OnClose="CloseEditors" Busy="IsBusy" />
    }
    <FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalM)" VerticalGap="var(--spacingVerticalM)" Class="budget-workspace">
        <div class="budget-categories">
            <BudgetCategoryTable Plan="Plan" Budget="_budget" OnCommand="OnCommand" OnSelect="EditCategory" Busy="IsBusy" SelectedCategoryId="_category?.Id" />
        </div>
        @if (_category is not null)
        {
            <aside class="category-details" aria-label="Category details">
                <CategoryEditor @key="(_category, _month)" Plan="Plan" Category="_category" MonthState="EditingMonth" Month="_month" OnCommand="OnCommand" OnClose="CloseEditors" Busy="IsBusy" />
            </aside>
        }
    </FluentStack>
    <details class="budget-help"><summary>Plan tips &amp; future assignments</summary><p class="muted">Positive balances roll forward. @Money(_budget.AssignedInFuture) is assigned in future months. Enter arithmetic such as 150 + 25 in any amount field. Drag a move handle to reorder, or click it for move controls. Rename a category beside its name, or press F2 on the name. Select a category to adjust its target.</p></details>
</div>
}
else if (_error is null) { <p role="status">Loading month…</p> }
