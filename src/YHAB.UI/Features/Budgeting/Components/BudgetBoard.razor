@inherits YHAB.UI.Components.CancellableComponentBase
@if (_error is not null) { <div class="notice" data-kind="error" role="alert">@_error</div> }
@if (_budget is not null)
{
<div class="budget-board">
    <section class="budget-summary" aria-label="Monthly budget summary" data-negative="@(_budget.ReadyToAssign < 0 ? "true" : "false")">
        <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.SpaceBetween" HorizontalGap="var(--spacingHorizontalM)" VerticalGap="var(--spacingVerticalS)">
            <div>
                <h1>Plan your money</h1>
                <FluentStack Width="auto" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalXS)" Class="month-navigation">
                    <FluentButton OnClick="PreviousAsync" Disabled="@(_month.Year <= 2000)" Size="ButtonSize.Small" IconOnly="true" Appearance="ButtonAppearance.Subtle" aria-label="Previous month">←</FluentButton>
                    <strong class="month-label">@_month.ToString("MMMM yyyy", Culture)</strong>
                    <FluentButton OnClick="NextAsync" Disabled="@(_month.Year >= 2100)" Size="ButtonSize.Small" IconOnly="true" Appearance="ButtonAppearance.Subtle" aria-label="Next month">→</FluentButton>
                    <FluentButton OnClick="CurrentAsync" Size="ButtonSize.Small" Appearance="ButtonAppearance.Subtle">Today</FluentButton>
                </FluentStack>
            </div>
            <div class="ready-balance">
                <BudgetTermHelp Term="@(_budget.ReadyToAssign < 0 ? BudgetTerm.Overassigned : BudgetTerm.ReadyToAssign)" OnExplain="ShowHelpAsync" />
                <strong class="hero-amount" role="status" aria-atomic="true" data-money-tone="@MoneyTone(_budget.ReadyToAssign)">@Money(_budget.ReadyToAssign)</strong>
            </div>
            <div class="summary-actions">
                <FluentStack Width="auto" Wrap="true" HorizontalGap="var(--spacingHorizontalS)" VerticalGap="var(--spacingVerticalXS)">
                    @if (HasAccounts)
                    {
                        <FluentButton OnClick="AutoAssignAsync" Disabled="@(IsBusy || FundTargetsHint is not null)" Size="ButtonSize.Small" Appearance="ButtonAppearance.Primary" title="@FundTargetsHint" aria-describedby="@(FundTargetsHint is null ? null : "fund-targets-hint")">Fund targets</FluentButton>
                        <FluentButton OnClick="ShowMove" Disabled="@(IsBusy || MoveMoneyHint is not null)" Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" title="@MoveMoneyHint" aria-describedby="@(MoveMoneyHint is null ? null : "move-money-hint")">Move money</FluentButton>
                    }
                    <FluentButton OnClick="ShowHelpAsync" Size="ButtonSize.Small" Appearance="ButtonAppearance.Subtle">How this works</FluentButton>
                </FluentStack>
                @if (HasAccounts && FundTargetsHint is not null) { <p class="action-hint muted" id="fund-targets-hint">@FundTargetsHint</p> }
                @if (HasAccounts && MoveMoneyHint is not null) { <p class="action-hint muted" id="move-money-hint">@MoveMoneyHint</p> }
            </div>
        </FluentStack>
        <FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalL)" VerticalGap="var(--spacingVerticalXS)" Class="budget-totals">
            <div class="budget-total"><BudgetTermHelp Term="@BudgetTerm.Assigned" OnExplain="ShowHelpAsync" /> <strong>@Money(_budget.Assigned)</strong></div>
            <div class="budget-total"><BudgetTermHelp Term="@BudgetTerm.Activity" OnExplain="ShowHelpAsync" /> <strong>@Money(_budget.Activity)</strong></div>
            <div class="budget-total"><BudgetTermHelp Term="@BudgetTerm.Available" OnExplain="ShowHelpAsync" /> <strong>@Money(_budget.Available)</strong></div>
            <div class="budget-total">
                <BudgetTermHelp Term="@BudgetTerm.StillNeeded" OnExplain="ShowHelpAsync" />
                <strong data-money-tone="@(StillNeeded > 0 ? "attention" : "neutral")">@Money(StillNeeded)</strong>
                @if (StillNeededBreakdown is { } breakdown) { <small class="still-needed-breakdown">@breakdown</small> }
            </div>
        </FluentStack>
    </section>
    @PlanActions
    @if (_help)
    {
        <section @ref="_helpPanel" class="budget-help" id="budget-help" aria-labelledby="budget-help-heading" tabindex="-1">
            <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.SpaceBetween" HorizontalGap="var(--spacingHorizontalM)">
                <h2 id="budget-help-heading">How YHAB works</h2>
                <FluentButton OnClick="HideHelp" Size="ButtonSize.Small" Appearance="ButtonAppearance.Subtle" aria-label="Close help">Close</FluentButton>
            </FluentStack>
            <p class="muted">Add the money you have, give it a job in categories, record spending, and adjust your plan. Positive balances roll forward. @Money(_budget.AssignedInFuture) is assigned in future months.</p>
            <dl class="budget-glossary">
                @foreach (var term in BudgetGlossary.All)
                {
                    <dt>@BudgetGlossary.Label(term)</dt>
                    <dd>@BudgetGlossary.Definition(term)</dd>
                }
            </dl>
            <p class="muted">Enter arithmetic such as 150 + 25 in any amount field. Select an Available balance to move money to Ready to assign or another category. Drag a move handle to reorder, or click it for move controls. Rename a category beside its name, or press F2 on the name. Select a category to adjust its target.</p>
        </section>
    }
    @if (_budget.CashOverspending + _budget.CreditOverspending > 0)
    {
        <div class="notice" data-kind="warning">@Money(_budget.CashOverspending) cash overspending and @Money(_budget.CreditOverspending) credit overspending. Open an overspent Available balance to cover it.</div>
    }
    @if (_move)
    {
        <MoveMoneyEditor Plan="Plan" Month="_month" OnCommand="OnCommand" OnClose="CloseEditors" Busy="IsBusy" />
    }
    <div class="budget-workspace-scope">
        <FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalM)" VerticalGap="var(--spacingVerticalM)" Class="budget-workspace">
            <FirstRunChecklist Plan="Plan" Budget="_budget" Hidden="@(_category is not null)" OnAddAccount="AddAccountAsync" OnAddCategory="AddCategoryAsync" OnShowHelp="ShowHelpAsync" Busy="IsBusy" />
            <div class="budget-categories">
                <BudgetCategoryTable @ref="_categoryTable" Plan="Plan" Budget="_budget" OnCommand="OnCommand" OnSelect="EditCategory" Busy="IsBusy" SelectedCategoryId="_category?.Id" />
            </div>
            @if (_category is not null)
            {
                <aside class="category-details" aria-label="Category details">
                    <CategoryEditor @key="(_category?.Id, _month, _editorEpoch)" Plan="Plan" Category="_category" MonthState="EditingMonth" Month="_month" OnCommand="OnCommand" OnClose="CloseEditors" Busy="IsBusy" />
                </aside>
            }
        </FluentStack>
    </div>
</div>
}
else
{
    @* The actions stay reachable when the month could not be read, and follow a heading here too. *@
    <h1>Plan your money</h1>
    @PlanActions
    @if (_error is null) { <p role="status">Loading month…</p> }
}
