<FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalM)" Class="page-heading">
    <div><p class="eyebrow">GIVE EVERY DOLLAR A PURPOSE</p><h1>Plan your money</h1></div>
    <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalS)" Class="month-navigation">
        <FluentButton OnClick="Previous" Disabled="@(_month.Year <= 2000)" Size="ButtonSize.Small" IconOnly="true" Appearance="ButtonAppearance.Subtle" aria-label="Previous month">←</FluentButton>
        <strong class="month-label">@_month.ToString("MMMM yyyy", Culture)</strong>
        <FluentButton OnClick="Next" Disabled="@(_month.Year >= 2100)" Size="ButtonSize.Small" IconOnly="true" Appearance="ButtonAppearance.Subtle" aria-label="Next month">→</FluentButton>
        <FluentButton OnClick="Current" Size="ButtonSize.Small" Appearance="ButtonAppearance.Subtle">Today</FluentButton>
    </FluentStack>
</FluentStack>
<section class="ready-card" data-negative="@(_budget.ReadyToAssign < 0 ? "true" : "false")">
    <FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalXL)">
        <div><p>@(_budget.ReadyToAssign < 0 ? "Overassigned" : "Ready to assign")</p><strong class="hero-amount">@Money(_budget.ReadyToAssign)</strong></div>
        <div class="ready-description"><h2>@ReadyTitle</h2><p>@ReadyDescription</p>
            <FluentButton OnClick="AutoAssignAsync" Disabled="@(Busy || _budget.ReadyToAssign <= 0)" Appearance="ButtonAppearance.Primary">Fund targets</FluentButton>
            <FluentButton OnClick="ShowMove" Disabled="Busy" Appearance="ButtonAppearance.Outline">Move money</FluentButton>
        </div>
    </FluentStack>
</section>
<FluentGrid Spacing="3" Class="summary-grid">
    <FluentGridItem Xs="6" Md="3"><div class="stat"><span>Assigned</span><strong>@Money(_budget.Assigned)</strong></div></FluentGridItem>
    <FluentGridItem Xs="6" Md="3"><div class="stat"><span>Activity</span><strong>@Money(_budget.Activity)</strong></div></FluentGridItem>
    <FluentGridItem Xs="6" Md="3"><div class="stat"><span>Available</span><strong>@Money(_budget.Available)</strong></div></FluentGridItem>
    <FluentGridItem Xs="6" Md="3"><div class="stat"><span>Underfunded</span><strong>@Money(_budget.Categories.Sum(item => Math.Max(item.TargetNeeded, -item.Available)))</strong></div></FluentGridItem>
</FluentGrid>
@if (_budget.CashOverspending + _budget.CreditOverspending > 0)
{
    <div class="notice" data-kind="warning">@Money(_budget.CashOverspending) cash overspending and @Money(_budget.CreditOverspending) credit overspending. Move money into these categories to cover it.</div>
}
@if (_move)
{
    <MoveMoneyEditor Plan="Plan" Month="_month" OnCommand="OnCommand" OnClose="CloseEditors" Busy="Busy" />
}
@if (_categoryEditor)
{
    <CategoryEditor @key="_category?.Id" Plan="Plan" Category="_category" Month="_month" OnCommand="OnCommand" OnClose="CloseEditors" Busy="Busy" />
}
@if (_groupEditor)
{
    <GroupEditor Plan="Plan" OnCommand="OnCommand" OnClose="CloseEditors" Busy="Busy" />
}
<FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalS)" Class="table-toolbar">
    <FluentSelect TOption="string" TValue="string" Label="View" Items="_filters" @bind-Value="_filter" />
    <FluentButton OnClick="AddCategory" Disabled="Busy" Appearance="ButtonAppearance.Subtle">+ Category</FluentButton>
    <FluentButton OnClick="AddGroup" Disabled="Busy" Appearance="ButtonAppearance.Subtle">Manage groups</FluentButton>
</FluentStack>
<div class="table-container budget-table-container" tabindex="0" aria-label="Monthly category budget">
    <table class="budget-table">
        <caption class="visually-hidden">Category budget for @_month.ToString("MMMM yyyy", Culture)</caption>
        <thead><tr><th scope="col">Category</th><th scope="col" class="numeric">Assigned</th><th scope="col" class="numeric">Activity</th><th scope="col" class="numeric">Available</th></tr></thead>
        <tbody>
            @foreach (var group in Plan.Groups.OrderBy(item => item.SortOrder))
            {
                var rows = Rows(group.Id).ToArray();
                if (rows.Length == 0) { continue; }
                <tr class="group-row"><th colspan="4" scope="rowgroup">@group.Name <span class="muted">· @Money(rows.Sum(item => item.Available)) available</span></th></tr>
                @foreach (var row in rows)
                {
                    <tr @key="row.Category.Id">
                        <th scope="row"><button class="category-link" @onclick="() => EditCategory(row.Category)">@row.Category.Name</button>
                            @if (row.Category.Target is not null)
                            {
                                <small class="target-caption">@TargetCaption(row)</small>
                                <progress class="target-progress" max="100" value="@Progress(row)" aria-label="@($"{row.Category.Name} target progress")"></progress>
                            }
                        </th>
                        <td class="numeric"><AmountInput @key="(row.Category.Id, _month, Plan.Version)" Label="@($"Assign to {row.Category.Name}")" Value="row.Assigned" ValueChanged="amount => AssignAsync(row.Category.Id, amount)" Disabled="Busy" /></td>
                        <td class="numeric money">@Money(row.Activity)</td>
                        <td class="numeric"><span class="available-pill" data-tone="@Tone(row)">@Money(row.Available)</span>@if (row.Available < 0) { <small>@(row.CashOverspending > 0 ? "Cash overspent" : "Credit overspent")</small> }</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
@if (!Plan.Categories.Any()) { <div class="empty-state"><h2>Make space for your priorities</h2><p>Add a category group, then the things you want your money to do.</p></div> }
<p class="muted">Positive balances roll forward. @Money(_budget.AssignedInFuture) is assigned in future months. Enter arithmetic such as 150 + 25 in any amount field.</p>
