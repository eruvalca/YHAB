<EditorSurface Title="@(Transaction is null ? "Add transaction" : "Edit transaction")" OnClose="OnClose">
    <FluentGrid Spacing="3">
        <FluentGridItem Xs="12" Md="6"><FluentTextInput Margin="0" Size="TextInputSize.Large" Label="Payee" @bind-Value="_payee" MaxLength="200" DataList="known-payees" /><datalist id="known-payees">@foreach (var payee in Payees.Where(item => item.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase)) { <option value="@payee"></option> }</datalist></FluentGridItem>
        <FluentGridItem Xs="12" Sm="6"><FluentSelect Margin="0" Size="ListSize.Large" TOption="string" TValue="string" Label="Money direction" Items="_directions" @bind-Value="_direction" @bind-Value:after="DirectionChanged" /></FluentGridItem>
        <FluentGridItem Xs="12" Sm="6"><AmountInput @ref="_amountInput" Label="Amount" Size="TextInputSize.Large" CommitOnSave="true" @bind-Value="Amount" ValidChanged="value => _amountValid = value" /></FluentGridItem>
        <FluentGridItem Xs="12" Md="6"><div class="form-field"><label for="transaction-date">@(_repeat == RepeatFrequency.None ? "Date" : "Next occurrence")</label><input id="transaction-date" type="date" @bind="_date" /></div></FluentGridItem>
        <FluentGridItem Xs="12" Md="6"><FluentSelect Margin="0" Size="ListSize.Large" TOption="AccountData" TValue="Guid" Label="Account" Items="_accounts" OptionText="item => item.Name" OptionValue="item => item.Id" @bind-Value="_account" /></FluentGridItem>
        <FluentGridItem Xs="12" Md="6"><FluentSelect Margin="0" Size="ListSize.Large" TOption="AccountData" TValue="Guid" Label="Transfer to or from" Items="_destinations" OptionText="item => item.Name" OptionValue="item => item.Id" @bind-Value="_transfer" /></FluentGridItem>
    </FluentGrid>
    @if (NeedsCategory)
    {
        @if (!_split)
        {
            <FluentSelect @key="_direction" Margin="0" Size="ListSize.Large" TOption="CategoryData" TValue="Guid" Label="Category"
                          Items="CategoryOptions" OptionText="item => item.Name" OptionValue="item => item.Id" Placeholder="@ChooseCategory"
                          aria-invalid="@(CategoryMissing ? "true" : "false")"
                          aria-describedby="@(CategoryMissing ? "transaction-category-error" : null)"
                          @bind-Value="_category" />
            @if (CategoryMissing)
            {
                <p @ref="_categoryError" id="transaction-category-error" tabindex="-1" class="validation-message" role="alert">@OutflowCategoryError</p>
            }
            <FluentButton OnClick="StartSplit" Size="ButtonSize.Large" Appearance="ButtonAppearance.Subtle">Split across categories</FluentButton>
        }
        else
        {
            <p class="muted">Enter signed split amounts: negative for outflows, positive for inflows. Remaining: @Money(SignedAmount - _splits.Sum(item => item.Amount))</p>
            @foreach (var split in _splits)
            {
                <FluentGrid @key="split.Id" Spacing="2">
                    <FluentGridItem Xs="12" Md="5">
                        <FluentSelect @key="SplitNeedsCategory(split)" Margin="0" Size="ListSize.Large" TOption="CategoryData" TValue="Guid" Label="Split category"
                                      Items="SplitCategoryOptions(split)" OptionText="item => item.Name" OptionValue="item => item.Id" Placeholder="@ChooseCategory"
                                      aria-invalid="@(SplitCategoryMissing(split) ? "true" : "false")"
                                      aria-describedby="@(SplitCategoryMissing(split) ? $"{split.Id}-category-error" : null)"
                                      @bind-Value="split.Category" />
                        @if (SplitCategoryMissing(split))
                        {
                            <p id="@($"{split.Id}-category-error")" class="validation-message" role="alert">@SplitCategoryError</p>
                        }
                    </FluentGridItem>
                    <FluentGridItem Xs="6" Md="3"><AmountInput @ref="split.AmountInput" Label="Split amount" Size="TextInputSize.Large" AllowNegative="true" CommitOnSave="true" @bind-Value="split.Amount" ValidChanged="value => split.Valid = value" /></FluentGridItem>
                    <FluentGridItem Xs="6" Md="4">
                        <FluentStack VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="var(--spacingHorizontalS)">
                            <FluentTextInput Margin="0" Size="TextInputSize.Large" Label="Split memo" @bind-Value="split.Memo" MaxLength="1000" />
                            <FluentButton OnClick="() => RemoveSplit(split)" Size="ButtonSize.Large" IconOnly="true" Appearance="ButtonAppearance.Subtle" aria-label="Remove split">×</FluentButton>
                        </FluentStack>
                    </FluentGridItem>
                </FluentGrid>
            }
            <FluentButton OnClick="AddSplit" Size="ButtonSize.Large" Appearance="ButtonAppearance.Subtle">+ Another split</FluentButton>
        }
    }
    <FluentGrid Spacing="3">
        <FluentGridItem Xs="12"><FluentTextArea Margin="0" Size="TextAreaSize.Large" Label="Memo" @bind-Value="_memo" MaxLength="4000" /></FluentGridItem>
        <FluentGridItem Xs="12" Sm="6"><FluentSelect Margin="0" Size="ListSize.Large" TOption="RepeatFrequency" TValue="RepeatFrequency" Label="Repeat" Items="_frequencies" OptionText="FrequencyLabel" @bind-Value="_repeat" /></FluentGridItem>
        <FluentGridItem Xs="12" Sm="6"><FluentSelect Margin="0" Size="ListSize.Large" TOption="string" TValue="string" Label="Flag" Items="_flags" @bind-Value="_flag" /></FluentGridItem>
    </FluentGrid>
    @if (_repeat == RepeatFrequency.None && _date > Plan.Today)
    {
        <div class="notice" data-kind="warning">Future transactions must repeat. One-off scheduled transactions aren't supported.</div>
    }
    else if (_repeat != RepeatFrequency.None)
    {
        <p class="muted">Due occurrences enter your register when you open the plan. The next occurrence stays here as a repeating instruction.</p>
    }
    <div class="editor-actions">
        <FluentButton OnClick="SaveAsync" Disabled="@CannotSave" Size="ButtonSize.Large" Appearance="ButtonAppearance.Primary">Save transaction</FluentButton>
    </div>
</EditorSurface>
