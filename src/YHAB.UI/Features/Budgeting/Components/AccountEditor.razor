<EditorSurface Title="@(_id == Guid.Empty ? "A place for your money" : "Account details")" OnClose="OnClose">
    <p class="muted">Enter the balance from your records. You can add transactions whenever you need.</p>
    <FluentGrid Spacing="3">
        <FluentGridItem Xs="12" Sm="6"><FluentTextInput Margin="0" Label="Account name" @bind-Value="_name" MaxLength="100" Required="true" /></FluentGridItem>
        <FluentGridItem Xs="12" Sm="6"><FluentSelect Margin="0" TOption="AccountKind" TValue="AccountKind" Label="Account type" Items="_kinds"
                      OptionText="AccountLabel" @bind-Value="_kind" Disabled="@(_id != Guid.Empty)" /></FluentGridItem>
        <FluentGridItem Xs="12" Sm="6"><div class="form-field"><label for="account-opening-date">Opening date</label><input id="account-opening-date" type="date" @bind="_openedOn" /></div></FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <AmountInput Label="Opening balance" @bind-Value="_balance" ValidChanged="value => _amountValid = value" />
            <p class="field-hint">Use a negative balance for money you owe.</p>
        </FluentGridItem>
        @if (BudgetFacts.IsLoan(_kind))
        {
            <FluentGridItem Xs="12" Sm="6"><AmountInput Label="Annual interest rate (%)" @bind-Value="_interest" ValidChanged="value => _interestValid = value" /></FluentGridItem>
            <FluentGridItem Xs="12" Sm="6"><AmountInput Label="Minimum monthly payment" @bind-Value="_minimum" ValidChanged="value => _minimumValid = value" /></FluentGridItem>
        }
    </FluentGrid>
    <FluentTextArea Margin="0" Label="Notes" @bind-Value="_notes" MaxLength="4000" />
    @if (_id != Guid.Empty)
    {
        <FluentCheckbox Margin="0" Label="Account is closed" LabelPosition="LabelPosition.Before" @bind-Value="_closed" />
    }
    <FluentStack HorizontalGap="var(--spacingHorizontalS)" Wrap="true">
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveAsync" Disabled="@(!_amountValid || !_interestValid || !_minimumValid || string.IsNullOrWhiteSpace(_name) || Busy)">Save account</FluentButton>
        <FluentButton OnClick="CancelAsync">Cancel</FluentButton>
    </FluentStack>
</EditorSurface>
