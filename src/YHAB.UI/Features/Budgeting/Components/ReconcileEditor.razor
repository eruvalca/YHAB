<EditorSurface Title="@($"Reconcile {Account.Name}")" OnClose="OnClose">
    <p>Compare your cleared balance with your bank's posted balance. Pending transactions stay uncleared.</p>
    <p>Cleared in YHAB: <strong class="money">@Money(_cleared)</strong></p>
    <AmountInput Label="Bank's posted balance" Size="TextInputSize.Large" AllowNegative="true" @bind-Value="_balance" ValidChanged="value => _valid = value" />
    @if (_balance != _cleared)
    {
        <div class="notice" data-kind="warning">Difference: @Money(_balance - _cleared). Check missing or uncleared entries before making an adjustment.</div>
        <FluentCheckbox Margin="0" Label="Create a balance adjustment for this difference" LabelPosition="LabelPosition.Before" @bind-Value="_adjust" />
    }
    <div class="editor-actions">
        <FluentButton OnClick="SaveAsync" Disabled="@(Busy || !_valid || (_balance != _cleared && !_adjust))" Size="ButtonSize.Large" Appearance="ButtonAppearance.Primary">Finish reconciliation</FluentButton>
    </div>
</EditorSurface>

