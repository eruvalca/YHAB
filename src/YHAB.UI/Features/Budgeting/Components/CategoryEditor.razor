<EditorSurface Title="@(Category is null ? "New category" : Category.Name)" OnClose="OnClose" HasUnsavedChanges="HasUnsavedChanges">
    <h3>Target</h3>
    <FluentCheckbox Margin="0" Label="Set a target" LabelPosition="LabelPosition.Before" @bind-Value="_hasTarget" />
    @if (_hasTarget)
    {
        <FluentGrid Spacing="3">
            <FluentGridItem Xs="12"><FluentSelect Margin="0" Size="ListSize.Large" TOption="TargetKind" TValue="TargetKind" Label="Target behavior" Items="_kinds" OptionText="KindLabel" aria-describedby="target-kind-description" @bind-Value="_kind" /></FluentGridItem>
            <FluentGridItem Xs="12"><FluentSelect Margin="0" Size="ListSize.Large" TOption="TargetCadence" TValue="TargetCadence" Label="Frequency" Items="_cadences" @bind-Value="_cadence" /></FluentGridItem>
            <FluentGridItem Xs="12"><AmountInput @ref="_amountInput" Label="Target amount" Size="TextInputSize.Large" CommitOnSave="true" @bind-Value="_amount" ValidChanged="value => _valid = value" /></FluentGridItem>
            @if (_cadence == TargetCadence.Weekly)
            {
                <FluentGridItem Xs="12"><FluentSelect Margin="0" Size="ListSize.Large" TOption="DayOfWeek" TValue="DayOfWeek" Label="Each" Items="_weekdays" @bind-Value="_weekday" /></FluentGridItem>
            }
            @if (_cadence is TargetCadence.Yearly or TargetCadence.Custom)
            {
                <FluentGridItem Xs="6"><div class="form-field"><label for="target-due">Have it by</label><input id="target-due" type="date" @bind="_due" /></div></FluentGridItem>
                @if (_cadence == TargetCadence.Custom)
                {
                    <FluentGridItem Xs="6"><div class="form-field"><label for="target-repeat">Repeat every (months, 0 = no repeat)</label><input id="target-repeat" type="number" min="0" max="120" @bind="_repeat" /></div></FluentGridItem>
                }
            }
        </FluentGrid>
        <p class="muted" id="target-kind-description">@TargetDescription</p>
    }
    <details class="category-options"><summary>Category details</summary>
    <FluentGrid Spacing="3">
        <FluentGridItem Xs="12"><FluentTextInput Margin="0" Size="TextInputSize.Large" Label="Category name" @bind-Value="_name" MaxLength="100" /></FluentGridItem>
        <FluentGridItem Xs="12"><FluentSelect Margin="0" Size="ListSize.Large" TOption="GroupData" TValue="Guid" Label="Category group" Items="Plan.Groups" OptionText="item => item.Name" OptionValue="item => item.Id" Value="_group" ValueChanged="SetGroup" /></FluentGridItem>
        <FluentGridItem Xs="12"><FluentCheckbox Margin="0" Label="Hide category" LabelPosition="LabelPosition.Before" @bind-Value="_hidden" /></FluentGridItem>
        <FluentGridItem Xs="12"><FluentTextArea Margin="0" Size="TextAreaSize.Large" Label="Notes" @bind-Value="_notes" MaxLength="4000" /></FluentGridItem>
    </FluentGrid>
    </details>
    <div class="editor-actions">
        <FluentButton OnClick="SaveAsync" Disabled="@(Busy || _saving || !_valid || string.IsNullOrWhiteSpace(_name) || _group == Guid.Empty)" Size="ButtonSize.Large" Appearance="ButtonAppearance.Primary">Save category</FluentButton>
        @if (Category?.Target is not null)
        {
            <FluentButton OnClick="SnoozeAsync" Disabled="Busy" Size="ButtonSize.Large" Appearance="ButtonAppearance.Subtle" aria-describedby="target-snooze-hint">@(_snoozed ? "Resume target this month" : "Snooze target this month")</FluentButton>
        }
    </div>
    @if (Category?.Target is not null)
    {
        <p class="muted" id="target-snooze-hint">@BudgetGlossary.Definition(BudgetTerm.Snooze)</p>
    }
    @if (Category is { CreditAccountId: null })
    {
        <details class="danger-zone"><summary>Remove category</summary>
            <p>Choose where its assignments and transactions should go. This change can be undone.</p>
            <FluentSelect Margin="0" Size="ListSize.Large" TOption="CategoryData" TValue="Guid" Label="Move history to" Items="_replacements" OptionText="item => item.Name" OptionValue="item => item.Id" @bind-Value="_replacement" />
            <FluentButton OnClick="RemoveAsync" Disabled="Busy" Appearance="ButtonAppearance.Outline">Remove and move history</FluentButton>
        </details>
    }
</EditorSurface>
