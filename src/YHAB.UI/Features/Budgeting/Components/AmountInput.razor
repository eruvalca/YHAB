<div class="amount-field@(AllowNegative ? " amount-field--signed" : "")">
    <div class="amount-entry" @onkeydown="KeyDownAsync" data-enter-saves="@(OnEnter.HasDelegate ? "true" : null)">
        <FluentTextInput Id="@Id" Label="@Label" Value="@_text" ValueChanged="EvaluateAsync" Immediate="@CommitOnSave"
                         Placeholder="0.00 or 25 + 10" InputMode="@InputMode" MaxLength="200" Size="@Size"
                         Class="amount-input" aria-invalid="@(_error is null ? "false" : "true")" aria-describedby="@(_error is null ? null : $"{Id}-error")"
                         Margin="0" Width="100%" Disabled="@Disabled" ReadOnly="@ReadOnly" OnFocusIn="FocusIn" />
    </div>
    @if (AllowNegative)
    {
        <FluentButton Class="amount-sign" Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Large" IconOnly="true" OnClick="ToggleSignAsync"
                      @onpointerdown="PrepareSignToggle" @onpointerup="EndSignPointer" @onpointercancel="CancelSignPointer" @onfocusin="SignFocusIn"
                      Disabled="@(Disabled || ReadOnly)" aria-label="@($"Change the sign of {Label}")" title="Change sign">±</FluentButton>
    }
</div>
@if (_error is not null)
{
    <p id="@($"{Id}-error")" class="validation-message" role="alert">@_error</p>
}
