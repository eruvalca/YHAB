<div class="plan-frame">
    <nav class="plan-page-tabs" aria-label="Plan pages">
        <NavLink href="@($"/plans/{Plan.Id}")" Match="NavLinkMatch.All">Plan</NavLink>
        <NavLink href="@($"/plans/{Plan.Id}/accounts")">Transactions</NavLink>
        <NavLink href="@($"/plans/{Plan.Id}/reports")">Reflect</NavLink>
        <NavLink href="@($"/plans/{Plan.Id}/settings")">Settings</NavLink>
    </nav>
    <FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalL)" VerticalGap="var(--spacingVerticalM)" Class="plan-shell">
        <aside class="plan-sidebar">
            <details class="plan-drawer">
                <summary>Plan &amp; accounts</summary>
                <PlanNavigation Plan="Plan" Balances="Balances" OnAddAccount="OnAddAccount" Busy="Busy" />
            </details>
        </aside>
        <div class="plan-content">@ChildContent</div>
    </FluentStack>
</div>
