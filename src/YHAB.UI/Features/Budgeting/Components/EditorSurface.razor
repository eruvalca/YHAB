<section class="editor-surface" aria-label="@Title">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalL)" Width="100%">
        <FluentStack Class="editor-heading" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.SpaceBetween" Width="100%">
            <h2 @ref="_heading" tabindex="-1">@Title</h2>
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="CloseAsync" Size="ButtonSize.Large" aria-label="Close editor">Close</FluentButton>
        </FluentStack>
        @ChildContent
    </FluentStack>
</section>
