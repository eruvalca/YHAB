@if (!RendererInfo.IsInteractive || Row.Available == 0m)
{
    <span class="available-pill" data-tone="@Tone">@Money(Row.Available)</span>
}
else
{
    <button type="button" id="@AnchorId" class="available-pill" data-tone="@Tone"
            aria-haspopup="dialog" aria-expanded="@(_open ? "true" : "false")" aria-label="@AriaLabel"
            @onclick="Toggle" @onclick:stopPropagation="true">@Money(Row.Available)</button>
    <FluentPopover AnchorId="@AnchorId" Opened="@_open" OpenedChanged="OpenedChangedAsync" Width="min(22rem, calc(100vw - 2rem))">
        @if (_open)
        {
            <div class="money-popover" role="dialog" aria-labelledby="@($"{AnchorId}-title")" @onclick:stopPropagation="true">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalS)" Width="100%">
                    <h2 id="@($"{AnchorId}-title")" class="money-popover-title">@Heading</h2>
                    @if (_targets.Length == 0)
                    {
                        <p class="muted">No other category or Ready to assign has money to cover this. Reduce an assignment or add income first.</p>
                        <FluentStack HorizontalGap="var(--spacingHorizontalS)">
                            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="Close">Close</FluentButton>
                        </FluentStack>
                    }
                    else
                    {
                        <p class="muted">@Description</p>
                        <FluentSelect Margin="0" TOption="CategoryData" TValue="Guid" Label="@SelectLabel" Items="_targets"
                                      OptionText="item => item.Name" OptionValue="item => item.Id"
                                      Value="@(_other ?? Guid.Empty)" ValueChanged="TargetChangedAsync" />
                        <AmountInput @ref="_amountInput" Label="Amount" CommitOnSave="true" RejectNegative="true" @bind-Value="_amount"
                                     ValidChanged="value => _valid = value" />
                        <p class="money-popover-limit">@LimitText</p>
                        <FluentStack HorizontalGap="var(--spacingHorizontalS)">
                            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="MoveAsync" Disabled="@(!CanMove)">Move money</FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="Close">Cancel</FluentButton>
                        </FluentStack>
                    }
                </FluentStack>
            </div>
        }
    </FluentPopover>
}
