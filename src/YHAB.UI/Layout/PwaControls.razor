<section id="pwa-update" class="notice" data-kind="information" aria-label="Application update" hidden>
    <p role="status" data-pwa-update-message>A new version of YHAB is ready. Save your work before reloading.</p>
    <FluentStack HorizontalGap="var(--spacingHorizontalS)" Wrap="true">
        <FluentButton Type="ButtonType.Button" Appearance="ButtonAppearance.Primary" data-pwa-reload tabindex="0">Reload to update</FluentButton>
        <FluentButton Type="ButtonType.Button" Appearance="ButtonAppearance.Subtle" data-pwa-later tabindex="0">Later</FluentButton>
    </FluentStack>
</section>

<details class="pwa-install" data-pwa-install-help>
    <summary>Install YHAB</summary>
    <p>Add YHAB to your home screen or desktop for quick access. Budgeting and sign-in require an internet connection.</p>
    <div data-pwa-install-action hidden>
        <FluentButton Type="ButtonType.Button" Appearance="ButtonAppearance.Primary" data-pwa-install tabindex="0">Install app</FluentButton>
    </div>
    <p>On iPhone or iPad, open the browser's Share menu and choose <strong>Add to Home Screen</strong>.
        On desktop or Android, look for <strong>Install app</strong> or <strong>Add to Home Screen</strong> in your browser's menu.</p>
    <p role="status" data-pwa-install-message></p>
</details>
